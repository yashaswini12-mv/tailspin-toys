---
import Layout from '../layouts/Layout.astro';
import GameCard from '../components/GameCard.astro';
import PageHero from '../components/PageHero.astro';
import EmptyState from '../components/EmptyState.astro';
import { getDatabase } from '../lib/db';
import { getAllGames } from '../lib/games';

export const prerender = true;

const games = await getAllGames(getDatabase());
const categoryNames = [...new Set(games.map((game) => game.category?.name).filter((name): name is string => Boolean(name)))];
const publisherNames = [...new Set(games.map((game) => game.publisher?.name).filter((name): name is string => Boolean(name)))];
---

<Layout title="Tailspin Toys - Crowdfunding your new favorite game!">
  <div class="py-8">
    <PageHero
      title="Welcome to Tailspin Toys"
      subtitle="Find your next game! And maybe even back one! Explore our collection!"
    />

    <div>
      <h2 class="text-2xl font-medium mb-6 text-slate-100">Featured Games</h2>

      {games.length === 0 ? (
        <EmptyState text="No games available at the moment." />
      ) : (
        <>
          <form class="mb-8 rounded-xl border border-slate-700 bg-slate-800/60 p-5" data-testid="game-filters">
            <fieldset>
              <legend class="mb-3 text-lg font-medium text-slate-100">Filter games</legend>
              <div class="grid gap-5 md:grid-cols-2">
                <div>
                  <span class="mb-2 block text-sm font-medium text-slate-300">Categories</span>
                  <div class="flex flex-wrap gap-3">
                    {categoryNames.map((categoryName) => (
                      <label class="flex items-center gap-2 text-sm text-slate-300">
                        <input
                          type="checkbox"
                          name="category"
                          value={categoryName}
                          class="h-4 w-4 rounded border-slate-600 bg-slate-900 text-blue-500 focus:ring-2 focus:ring-blue-500"
                          data-testid={`category-filter-${categoryName.toLowerCase()}`}
                        />
                        {categoryName}
                      </label>
                    ))}
                  </div>
                </div>
                <div>
                  <label for="publisher-filter" class="mb-2 block text-sm font-medium text-slate-300">Publisher</label>
                  <select
                    id="publisher-filter"
                    class="w-full rounded-lg border border-slate-600 bg-slate-900 px-3 py-2 text-slate-100 focus:ring-2 focus:ring-blue-500 focus:outline-none"
                    data-testid="publisher-filter"
                  >
                    <option value="">All publishers</option>
                    {publisherNames.map((publisherName) => <option value={publisherName}>{publisherName}</option>)}
                  </select>
                </div>
              </div>
            </fieldset>
          </form>

          <p class="mb-4 text-sm text-slate-400" data-testid="filter-results-count" aria-live="polite">
            Showing {games.length} games
          </p>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-2 lg:grid-cols-3" data-testid="games-grid">
            {games.map((game) => (
              <div
                data-category={game.category?.name ?? ''}
                data-publisher={game.publisher?.name ?? ''}
                data-game-wrapper
              >
                <GameCard game={game} />
              </div>
            ))}
          </div>
          <div class="hidden" data-testid="filter-no-results">
            <EmptyState text="No games match the selected filters." />
          </div>
        </>
      )}
    </div>
  </div>
</Layout>

<script>
  const filterForm = document.querySelector<HTMLFormElement>('[data-testid="game-filters"]');
  const gameWrappers = Array.from(document.querySelectorAll<HTMLElement>('[data-game-wrapper]'));
  const resultCount = document.querySelector<HTMLElement>('[data-testid="filter-results-count"]');
  const noResults = document.querySelector<HTMLElement>('[data-testid="filter-no-results"]');

  filterForm?.addEventListener('change', () => {
    const selectedCategories = new Set(
      Array.from(filterForm.querySelectorAll<HTMLInputElement>('input[name="category"]:checked'))
        .map((input) => input.value),
    );
    const selectedPublisher = filterForm.querySelector<HTMLSelectElement>('#publisher-filter')?.value ?? '';
    let visibleCount = 0;

    gameWrappers.forEach((wrapper) => {
      const categoryMatches = selectedCategories.size === 0 || selectedCategories.has(wrapper.dataset.category ?? '');
      const publisherMatches = selectedPublisher === '' || wrapper.dataset.publisher === selectedPublisher;
      const isVisible = categoryMatches && publisherMatches;
      wrapper.hidden = !isVisible;
      if (isVisible) visibleCount += 1;
    });

    if (resultCount) resultCount.textContent = `Showing ${visibleCount} games`;
    if (noResults) noResults.hidden = visibleCount !== 0;
  });
</script>
